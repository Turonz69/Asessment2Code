#Receipt Section

def Receipt(Member_Type, Limit, Attend, New_Sessions,
                 Total_Session, Remaining_Sessions, Exceed, Costs, Membership_Status):

    print("\n===============================")
    print("MIT Session Tracker")
    print("=================================")

    print(f"Member Type:{Member_Type.capitalize()}")
    print(f"Weekly Limit:{Limit}")
    print(f"Sessions Attend:{Attend}")
    print(f"New Sessions:{New_Sessions}")
    print(f"Total_Session Sessions: {Total_Session}")
    print(f"Membership_Status:{Membership_Status}")

    if Membership_Status == "Within Limit":
        print(f"Sessions Remaining_Sessions:{Remaining_Sessions}")
        print("Extra Sessions: 0")
        print("Costs per Session: $8")
        print("Total_Session Extra Costs: $0")
    else:
        print("Sessions Remaining_Sessions: 0")
        print(f"Extra Sessions: {Exceed}")
        print("Costs per Session: $8")
        print("-----------------------------------")
        print(f"Total_Session Extra Costs: ${Costs}")

    print("\n========================================")
    print("Thank you for using the MIT Session Tracker")
    print("Have a Good Day, Cheers!!!")
    print("=========================================\n")


